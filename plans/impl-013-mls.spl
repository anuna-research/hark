(normally r-ready-safety (and task-safety completed-group) ready-safety)
(normally r-ready-wiring (and task-wiring completed-removal completed-safety) ready-wiring)
(normally r-ready-integration (and task-integration completed-wiring) ready-integration)
(normally r-ready-affected (and task-affected completed-integration) ready-affected)

(meta r-ready-deps (description "No dependencies — start here.") (justification "Everything builds on the mls module skeleton + identity-bound signer."))
(meta r-ready-storage (description "Needs the mls module skeleton.") (justification "Provider implements openmls_traits against the pinned versions."))
(meta r-ready-pins (description "Needs the mls module skeleton.") (justification "DS labels + pin store are independent of storage."))
(meta r-ready-keypkgs (description "Needs durable storage.") (justification "REQ-013 ledger and init-key deletion are storage-backed."))
(meta r-ready-group (description "Needs pins + keypackages.") (justification "Welcome validation checks leaves against pins; adds consume KeyPackages."))
(meta r-ready-validation (description "Needs group lifecycle.") (justification "REQ-017 validates objects against live group state."))
(meta r-ready-removal (description "Needs inbound validation.") (justification "REQ-014 evidence is verified inside the REQ-017 merge path."))
(meta r-ready-safety (description "Needs group lifecycle.") (justification "Safety number reads group_id + membership bindings."))
(meta r-ready-wiring (description "Needs everything crypto-complete.") (justification "Session wiring composes all module pieces into chat.rs."))
(meta r-ready-integration (description "Needs full wiring.") (justification "End-to-end verification of the assembled capability."))
(meta r-ready-affected (description "hark side proven first.") (justification "hark is the test oracle for the cross-repo wire changes."))

