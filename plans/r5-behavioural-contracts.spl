(normally r-propagate-inbound-from-infra-failed failed-infra upstream-blocked-inbound)
(normally r-propagate-inbound-from-infra-permanently-failed permanently-failed-infra upstream-blocked-inbound)
(normally r-propagate-inbound-from-infra-stale-v1 stale-v1-infra upstream-blocked-inbound)
(normally r-propagate-inbound-from-infra-timeout-v1 timeout-v1-infra upstream-blocked-inbound)
(normally r-propagate-inbound-from-infra-blocked upstream-blocked-infra upstream-blocked-inbound)
(normally r-propagate-outbound-from-infra-failed failed-infra upstream-blocked-outbound)
(normally r-propagate-outbound-from-infra-permanently-failed permanently-failed-infra upstream-blocked-outbound)
(normally r-propagate-outbound-from-infra-stale-v1 stale-v1-infra upstream-blocked-outbound)
(normally r-propagate-outbound-from-infra-timeout-v1 timeout-v1-infra upstream-blocked-outbound)
(normally r-propagate-outbound-from-infra-blocked upstream-blocked-infra upstream-blocked-outbound)

