(normally r-propagate-specs-docs-from-inbound-blocked upstream-blocked-inbound upstream-blocked-specs-docs)
(normally r-propagate-tests-from-inbound-blocked upstream-blocked-inbound upstream-blocked-tests)
(normally r-propagate-specs-docs-from-outbound-blocked upstream-blocked-outbound upstream-blocked-specs-docs)
(normally r-propagate-tests-from-outbound-blocked upstream-blocked-outbound upstream-blocked-tests)
(normally r-propagate-polish-from-specs-docs-blocked upstream-blocked-specs-docs upstream-blocked-polish)
(normally r-propagate-polish-from-tests-blocked upstream-blocked-tests upstream-blocked-polish)

(claims agent:hugo
  :at "2026-05-11T14:03:01Z"
  (given completed-infra))

(claims agent:hugo
  :at "2026-05-11T14:03:01Z"
