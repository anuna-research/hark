(define f12206c01de420d0205674c385556d81c5344d00ecbcdc1ef16e65ed12c4168219693 (cbcl) @object
  (:resource-requirements ((max-depth 16) (max-expansion-size 4096) (verification-time 1000)))
  (:roles (owner (* proposer)))
  (extend open (to scope) :from owner :to (owner proposer) (tell to :scope scope))
  (extend set (to setting value clock) :from owner :to (owner proposer) (tell to :setting setting :value value :clock clock))
  (extend unset (to setting) :from owner :to (owner proposer) (tell to :setting setting))
  (extend propose (to setting value note registry) :from proposer :to (owner) (tell to :setting setting :value value :note note :registry registry))
  (extend decline (to setting proposal) :from owner :to (proposer) (tell to :setting setting :proposal proposal))
  (shape open (require :scope string))
  (shape set (require :setting string) (require :value string) (require :clock hlc))
  (shape unset (require :setting string))
  (shape propose (require :setting string) (require :value string) (require :note string) (require :registry string))
  (shape decline (require :setting string) (require :proposal string))
  (protocol (then begin open) (then open set) (then open unset) (then open propose) (then propose decline))
  (state (scope (initial open :scope)) (values (lww-map set :setting :value :clock unset)) (proposals (events propose :setting)) (declined (events decline :proposal))))
