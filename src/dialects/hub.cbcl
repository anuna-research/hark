;; hub dialect (SPEC-016) — the cbcl-chat control plane as a real CBCL dialect.
;;
;; The hub's control performatives (agent pairing + legibility) were previously
;; bare custom performatives: well-formed s-expressions the hub routed by name,
;; but NOT valid CBCL *messages* (the strict evaluator rejects an unscoped
;; custom performative as UnknownPerformative). Defining them here makes them
;; resolve against the registry — a bare `(addagent …)` is now valid CBCL,
;; while the hub still routes it by its head performative (no `(lang …)` wrapper,
;; so dispatch is unchanged).
;;
;; Verified well-formed (R1/R2/R3/R5) by cbcl_erl:verify_dialect at startup.

(define hub (cbcl) @cbcl-chat
  (:resource-requirements ((max-depth 8) (max-expansion-size 512) (verification-time 10)))

  ;; SPEC-016 REQ-006: an agent advertises itself + its dialects (+ its adder).
  (extend announce (agent dialects added-by)
    (tell @room (agent-presence :agent agent :dialects dialects :added-by added-by)))

  ;; SPEC-016 REQ-007: a member mints an agent pairing record.
  (extend addagent (name dialects)
    (tell @room (pair-request :name name :dialects dialects)))

  ;; SPEC-016 REQ-007: the hub returns the pairing id + Wormhole-style code.
  (extend paircode (name id code)
    (tell @room (pair-code :name name :id id :code code)))

  ;; SPEC-016 REQ-012: the adder de-lists an agent it added.
  (extend removeagent (name)
    (tell @room (remove-request :name name)))

  ;; SPEC-016 REQ-012: the hub acks a removal.
  (extend agent-removed (name)
    (tell @room (removal-ack :name name))))
