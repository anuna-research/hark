;; hub dialect (SPEC-016) — the cbcl-chat control plane as a real CBCL dialect.
;;
;; The hub's control performatives were bare custom performatives: well-formed
;; s-expressions the hub routes by name, but NOT valid CBCL *messages* (the
;; strict evaluator rejects an unscoped custom performative as
;; UnknownPerformative). Defining them here makes them resolve against the
;; registry — a bare `(addagent …)` / `(presence …)` is now valid CBCL, while
;; the hub still routes by the head performative (no `(lang …)` wrapper, so
;; dispatch is unchanged). `@room` is the recipient placeholder; undeclared
;; keywords (e.g. the universal `:from`, or `:key`/`:cap` on a hello) are
;; tolerated, so each performative declares only its content params.
;;
;; Covers the whole control plane EXCEPT the core CBCL verbs (tell/ask/reply/
;; error/ok/cancel/hello/bye — the base dialect) and the verbs that already
;; have their own dialect (cite, propose/vote in poll, do in concierge, and the
;; MLS epoch-movement verbs in mls-epoch).
;;
;; The epoch-movement verbs are in their own grammar because that grammar's
;; DIGEST is the epoch protocol's version and the capability name a client
;; declares to say it implements it (SPEC-063 CON-004). Declaring them here would
;; version them with the whole control plane, so adding an unrelated hub verb
;; would silently change what "implements the epoch protocol" means. SPEC-063
;; ADR-005.
;;
;; Verified well-formed (R1/R2/R3/R5) by cbcl_erl:verify_dialect at startup.

(define hub (cbcl) @cbcl-chat
  (:resource-requirements ((max-depth 8) (max-expansion-size 512) (verification-time 10)))

  ;; --- SPEC-016 agent pairing + legibility ------------------------------
  (extend announce (agent dialects added-by)
    (tell @room (agent-presence :agent agent :dialects dialects :added-by added-by)))
  (extend addagent (name dialects)
    (tell @room (pair-request :name name :dialects dialects)))
  (extend paircode (name id code)
    (tell @room (pair-code :name name :id id :code code)))
  (extend removeagent (name)
    (tell @room (remove-request :name name)))
  (extend agent-removed (name)
    (tell @room (removal-ack :name name)))

  ;; --- SPEC-001 rooms: presence, config, invites, directory, history ----
  ;; :agents carries the channel's pairing provenance as (agent adder) pairs, so
  ;; a member who joined AFTER an agent announced itself still knows which of the
  ;; roster are agents (SPEC-016 REQ-002/010).
  (extend presence (members agents)
    (tell @room (roster :members members :agents agents)))
  (extend roomcfg (enc dialects)
    (tell @room (room-config :enc enc :dialects dialects)))

  ;; --- SPEC-015 channel dialects: declare / undeclare / acquire ---------
  (extend adddialect (name digest def)
    (tell @room (dialect-declare :name name :digest digest :def def)))
  (extend removedialect (name)
    (tell @room (dialect-undeclare :name name)))
  (extend fetchdialect (digest)
    (tell @room (dialect-fetch :digest digest)))
  (extend invite (ttl uses)
    (tell @room (invite-request :ttl ttl :uses uses)))
  (extend invited (token ttl uses)
    (tell @room (invite-token :token token :ttl ttl :uses uses)))
  (extend channels (public)
    (tell @room (channel-directory :public public)))
  (extend history (before limit)
    (tell @room (history-request :before before :limit limit)))

  ;; --- SPEC-002 MLS KeyPackage directory + E2EE delivery ----------------
  (extend keypub (last onetime)
    (tell @room (keypackage-publish :last last :onetime onetime)))
  (extend keyget (for)
    (tell @room (keypackage-request :for for)))
  (extend keypkg (for kp)
    (tell @room (keypackage :for for :kp kp)))
  (extend welcome (for ct)
    (tell @room (mls-welcome :for for :ct ct)))
  (extend deliver (enc epoch ct)
    (tell @room (mls-message :enc enc :epoch epoch :ct ct)))

  ;; --- SPEC-061 REQ-007: the creator's admission grant, SEALED -----------
  ;; The hub carries ciphertext it cannot read: the key lives only in the invite
  ;; link, which is what lets that link be ~72 characters instead of ~382.
  ;; `sealedgrant` is the deposit, `sealedgrantget` the fetch, `sealedgrantok`
  ;; the hub's confirmation that it holds the bytes — a link is inert until then,
  ;; so the minting client waits for it before showing anyone a URL.
  ;;
  ;; HERE AND NOT IN mls-epoch.cbcl, deliberately. That file's BYTES are the
  ;; SPEC-063 protocol version — its sha256 is the capability name a client
  ;; declares — so adding a verb to it is a protocol change that deactivates
  ;; one-committer-per-epoch in every mixed room until both stacks carry the new
  ;; bytes. These verbs move an invite's carriage, not a group's epoch, and have
  ;; no business costing that. hub.cbcl is the general control plane and takes
  ;; additions without versioning anything.
  (extend sealedgrant (token sealed)
    (tell @room (mls-sealed-grant :token token :sealed sealed)))
  (extend sealedgrantget (token)
    (tell @room (mls-sealed-grant-request :token token)))
  (extend sealedgrantok (token)
    (tell @room (mls-sealed-grant-stored :token token)))

  ;; --- SPEC-063 CON-004: room-wide capability negotiation ----------------
  ;; The capabilities EVERY member presently in the room declared — an
  ;; INTERSECTION, not a union, because a promise the room does not keep
  ;; unanimously is a false one. Generic: a capability name is opaque to the hub,
  ;; which matches them and interprets none, so this belongs to the control plane
  ;; rather than to any one protocol that happens to be negotiated with it.
  (extend roomcaps (active)
    (tell @room (room-capabilities :active active))))
